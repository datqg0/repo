## Bước 4: Bộ lọc Thô & Băm nội dung (`src/pre_filter.py`)

Xử lý xóa số điện thoại/ký tự rác để tạo mã băm `content_hash` chuẩn xác, đồng thời chặn ngay các bài không liên quan trước khi gọi AI:

```python
# src/pre_filter.py
import re
import hashlib
from config import NEGATIVE_KEYWORDS, POSITIVE_KEYWORDS

def compute_content_hash(text: str) -> str:
    """Chuẩn hóa văn bản (bỏ số, ký tự đặc biệt, khoảng trắng) rồi băm MD5."""
    clean = text.lower()
    clean = re.sub(r'\d+', '', clean)            # Xóa ngày tháng, số điện thoại để bắt bài đăng lại
    clean = re.sub(r'[^\w\s]', '', clean)        # Xóa dấu câu, icon
    clean = re.sub(r'\s+', ' ', clean).strip()   # Gộp khoảng trắng
    # Lấy tối đa 300 ký tự cốt lõi ở đầu bài để băm
    core_sample = clean[:300]
    return hashlib.md5(core_sample.encode("utf-8")).hexdigest()

def passes_keyword_filter(text: str) -> tuple[bool, str]:
    """Kiểm tra xem văn bản có vượt qua bộ lọc từ khóa không."""
    if not text or len(text.strip()) < 60:
        return False, "Bài quá ngắn (< 60 ký tự)"

    lower_text = text.lower()

    # 1. Dính từ khóa cấm -> Loại ngay
    for neg in NEGATIVE_KEYWORDS:
        if neg in lower_text:
            return False, f"Chứa từ khóa loại trừ: '{neg}'"

    # 2. Phải chứa ít nhất 1 từ khóa mục tiêu
    if not any(pos in lower_text for pos in POSITIVE_KEYWORDS):
        return False, "Không chứa từ khóa tuyển dụng/công nghệ mục tiêu"

    return True, "OK"

```

