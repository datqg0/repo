## Bước 3: Cơ sở dữ liệu SQLite chống trùng lặp (`src/db.py`)

File này tự động tạo file `data/jobs.db`, kiểm tra xem một bài viết đã từng xuất hiện chưa, và đếm số lần HR đăng lại bài đó:

```python
# src/db.py
import sqlite3
from pathlib import Path

DB_PATH = Path(__file__).resolve().parent.parent / "data" / "jobs.db"

def get_conn():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    return sqlite3.connect(DB_PATH)

def init_db():
    with get_conn() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS jobs (
                raw_id TEXT PRIMARY KEY,
                content_hash TEXT,
                source TEXT,
                company TEXT,
                role_title TEXT,
                seniority_level TEXT,
                tech_stack TEXT,
                salary_info TEXT,
                ai_score INTEGER DEFAULT 0,
                url TEXT,
                repost_count INTEGER DEFAULT 1,
                status TEXT DEFAULT 'new',
                first_seen_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                last_seen_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        conn.execute("CREATE INDEX IF NOT EXISTS idx_content_hash ON jobs(content_hash)")

def is_duplicate_or_repost(raw_id: str, content_hash: str) -> bool:
    """Trả về True nếu bài đã từng quét (theo ID hoặc theo nội dung giống hệt)."""
    with get_conn() as conn:
        # 1. Kiểm tra trùng đúng ID bài viết
        row = conn.execute("SELECT 1 FROM jobs WHERE raw_id = ?", (raw_id,)).fetchone()
        if row:
            return True

        # 2. Kiểm tra trùng nội dung (HR đăng cùng 1 bài ở nhiều nơi hoặc đăng lại)
        hash_row = conn.execute(
            "SELECT raw_id FROM jobs WHERE content_hash = ?", (content_hash,)
        ).fetchone()
        if hash_row:
            conn.execute("""
                UPDATE jobs 
                SET repost_count = repost_count + 1, last_seen_at = CURRENT_TIMESTAMP 
                WHERE content_hash = ?
            """, (content_hash,))
            return True

    return False

def save_job(job_data: dict):
    with get_conn() as conn:
        conn.execute("""
            INSERT OR REPLACE INTO jobs 
            (raw_id, content_hash, source, company, role_title, seniority_level, 
             tech_stack, salary_info, ai_score, url, status)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            job_data["raw_id"],
            job_data["content_hash"],
            job_data["source"],
            job_data.get("company", ""),
            job_data.get("role_title", ""),
            job_data.get("seniority_level", ""),
            job_data.get("tech_stack", ""),
            job_data.get("salary_info", ""),
            job_data.get("ai_score", 0),
            job_data["url"],
            job_data["status"]
        ))

