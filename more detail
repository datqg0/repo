## Bước 5: Trình cào LinkedIn không cần trình duyệt (`src/linkedin_api.py`)

Gọi thẳng vào API ẩn của LinkedIn để lấy danh sách việc làm mới đăng trong 24 giờ qua:

```python
# src/linkedin_api.py
import time
import random
import httpx
from bs4 import BeautifulSoup
from config import LINKEDIN_KEYWORDS, LINKEDIN_LOCATION
from db import is_duplicate_or_repost

HEADERS = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
}

def fetch_linkedin_jobs() -> list[dict]:
    collected_jobs = []
    seen_in_session = set()

    with httpx.Client(headers=HEADERS, timeout=15.0) as client:
        for kw in LINKEDIN_KEYWORDS:
            print(f"[LinkedIn] Đang quét từ khóa: {kw}...")
            search_url = (
                "https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search"
                f"?keywords={httpx.URL(kw)}&location={httpx.URL(LINKEDIN_LOCATION)}"
                "&f_TPR=r86400&sortBy=DD&start=0"
            )
            try:
                resp = client.get(search_url)
                if resp.status_code != 200:
                    continue

                soup = BeautifulSoup(resp.text, "html.parser")
                cards = soup.find_all("div", class_="base-card")

                for card in cards:
                    urn = card.get("data-entity-urn", "")
                    if not urn or ":" not in urn:
                        continue
                    job_id = urn.split(":")[-1]
                    raw_id = f"li_{job_id}"

                    # Bỏ qua ngay nếu đã quét ở từ khóa trước hoặc đã có trong DB
                    if raw_id in seen_in_session or is_duplicate_or_repost(raw_id, ""):
                        continue
                    seen_in_session.add(raw_id)

                    # Gọi API lấy nội dung chi tiết JD
                    time.sleep(random.uniform(1.2, 2.5))
                    detail_url = f"https://www.linkedin.com/jobs-guest/jobs/api/jobPosting/{job_id}"
                    detail_resp = client.get(detail_url)
                    if detail_resp.status_code != 200:
                        continue

                    detail_soup = BeautifulSoup(detail_resp.text, "html.parser")
                    title_el = detail_soup.find("h2", class_="top-card-layout__title")
                    comp_el = detail_soup.find("a", class_="topcard__org-name-link")
                    desc_el = detail_soup.find("div", class_="show-more-less-html__markup")

                    title = title_el.get_text(strip=True) if title_el else ""
                    company = comp_el.get_text(strip=True) if comp_el else "Ẩn danh"
                    desc = desc_el.get_text(separator="\n", strip=True) if desc_el else ""

                    full_text = f"Công ty: {company}\nVị trí: {title}\nMô tả:\n{desc}"
                    collected_jobs.append({
                        "raw_id": raw_id,
                        "source": "linkedin",
                        "raw_text": full_text,
                        "url": f"https://www.linkedin.com/jobs/view/{job_id}/"
                    })
            except Exception as e:
                print(f"[LinkedIn] Lỗi khi quét '{kw}': {e}")

    return collected_jobs

```

