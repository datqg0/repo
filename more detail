```python
# src/main.py
import time
from config import MIN_SCORE_NOTIFY
from db import init_db, is_duplicate_or_repost, save_job
from pre_filter import compute_content_hash, passes_keyword_filter
from linkedin_api import fetch_linkedin_jobs
from fb_cdp_listener import fetch_facebook_group_jobs
from ai_scorer import evaluate_job_with_ai
from notifier import send_telegram_alert

def run_pipeline():
    print("=== BẮT ĐẦU CHU KỲ QUÉT VIỆC LÀM ===")
    init_db()

    # 1. Thu thập dữ liệu thô từ cả LinkedIn và Facebook Group
    raw_jobs = []
    raw_jobs.extend(fetch_linkedin_jobs())
    raw_jobs.extend(fetch_facebook_group_jobs())
    print(f"\n[Tổng hợp] Thu về {len(raw_jobs)} bài viết thô. Bắt đầu lọc...")

    new_qualified_count = 0

    for job in raw_jobs:
        raw_id = job["raw_id"]
        raw_text = job["raw_text"]
        content_hash = compute_content_hash(raw_text)

        # 2. Kiểm tra trùng lặp trong SQLite (Tốn 0ms, 0 token)
        if is_duplicate_or_repost(raw_id, content_hash):
            continue

        # 3. Kiểm tra bộ lọc từ khóa (Negative & Positive Keywords)
        passed, reason = passes_keyword_filter(raw_text)
        if not passed:
            save_job({
                "raw_id": raw_id,
                "content_hash": content_hash,
                "source": job["source"],
                "url": job["url"],
                "status": "rejected_keyword"
            })
            continue

        # 4. Gọi Gemini chấm điểm chất lượng
        print(f"[AI] Đang chấm điểm bài mới: {raw_id} ({job['source']})...")
        ai_res = evaluate_job_with_ai(raw_text)
        time.sleep(2.0)  # Giãn cách nhẹ tránh chạm Rate Limit của gói Gemini Free

        if not ai_res or not ai_res.get("is_valid_job"):
            save_job({
                "raw_id": raw_id,
                "content_hash": content_hash,
                "source": job["source"],
                "url": job["url"],
                "status": "not_a_job"
            })
            continue

        score = ai_res.get("total_score", 0)
        status = "notified" if score >= MIN_SCORE_NOTIFY else "low_score"

        # 5. Lưu kết quả vào SQLite
        save_job({
            "raw_id": raw_id,
            "content_hash": content_hash,
            "source": job["source"],
            "company": ai_res.get("company_name", ""),
            "role_title": ai_res.get("role_title", ""),
            "seniority_level": ai_res.get("seniority_level", ""),
            "tech_stack": ", ".join(ai_res.get("tech_stack", [])),
            "salary_info": ai_res.get("salary_info", ""),
            "ai_score": score,
            "url": job["url"],
            "status": status
        })

        # 6. Bắn thông báo nếu điểm đạt chuẩn (>= 70 điểm)
        if score >= MIN_SCORE_NOTIFY:
            new_qualified_count += 1
            send_telegram_alert(job, ai_res)

    print(f"=== HOÀN TẤT! Phát hiện {new_qualified_count} việc làm chất lượng cao mới. ===")

if __name__ == "__main__":
    run_pipeline()

