### 6.2. Viết code lắng nghe gói tin GraphQL (`src/fb_cdp_listener.py`)

Khi Playwright cuộn trang, Facebook trả về các cục dữ liệu qua `/api/graphql/`. Hàm đệ quy dưới đây sẽ tự động móc toàn bộ các bài viết nằm bên trong gói JSON đó mà không sợ Facebook đổi class HTML:

```python
# src/fb_cdp_listener.py
import json
import time
import random
from playwright.sync_api import sync_playwright
from config import FB_GROUP_URLS

def extract_posts_from_json(obj, found_posts: dict):
    """Đệ quy tìm các node bài viết (Story) bên trong JSON GraphQL của Facebook."""
    if isinstance(obj, dict):
        # Một bài đăng trong Group thường có 'post_id' và nội dung nằm ở 'message.text'
        post_id = obj.get("post_id")
        message = obj.get("message")
        if post_id and isinstance(message, dict) and message.get("text"):
            text = message["text"]
            url = obj.get("url") or f"https://www.facebook.com/{post_id}"
            if len(text) > 60:
                found_posts[f"fb_{post_id}"] = {
                    "raw_id": f"fb_{post_id}",
                    "source": "facebook_group",
                    "raw_text": text,
                    "url": url
                }
        for val in obj.values():
            extract_posts_from_json(val, found_posts)
    elif isinstance(obj, list):
        for item in obj:
            extract_posts_from_json(item, found_posts)

def fetch_facebook_group_jobs() -> list[dict]:
    found_posts = {}

    def handle_response(response):
        if "/api/graphql/" in response.url and response.status == 200:
            try:
                raw_body = response.text()
                # Facebook thường trả về nhiều dòng JSON nối nhau (NDJSON)
                for line in raw_body.splitlines():
                    line = line.strip()
                    if line.startswith("{"):
                        data = json.loads(line)
                        extract_posts_from_json(data, found_posts)
            except Exception:
                pass

    try:
        with sync_playwright() as p:
            print("[Facebook] Đang kết nối vào Chrome thật qua cổng 9222...")
            browser = p.chromium.connect_over_cdp("http://127.0.0.1:9222")
            context = browser.contexts[0]
            page = context.new_page()
            page.on("response", handle_response)

            for group_url in FB_GROUP_URLS:
                print(f"[Facebook] Đang mở Group: {group_url}")
                page.goto(group_url, wait_until="domcontentloaded", timeout=45000)
                time.sleep(random.uniform(4.0, 6.0))

                # Cuộn trang 5 lần với nhịp nghỉ tự nhiên như người thật
                for step in range(5):
                    page.mouse.wheel(0, random.randint(700, 1100))
                    print(f"  -> Đã cuộn lần {step + 1}/5, đang lắng nghe gói tin GraphQL...")
                    time.sleep(random.uniform(3.5, 7.5))

                # Nghỉ giữa các Group
                time.sleep(random.uniform(8.0, 12.0))

            page.close()
    except Exception as e:
        print(f"[Facebook] Không kết nối được cổng 9222 (Hãy bật start_chrome_debug.bat trước): {e}")

    print(f"[Facebook] Thu hoạch được {len(found_posts)} bài viết từ gói tin ngầm.")
    return list(found_posts.values())

```

