## Bước 7: Bộ não chấm điểm bằng Gemini API (`src/ai_scorer.py`)

Sử dụng SDK `google-genai` mới nhất kèm `Pydantic Schema` để ép `gemini-2.5-flash` trả về đúng định dạng JSON và chấm điểm theo thang 100:

```python
# src/ai_scorer.py
from pydantic import BaseModel, Field
from google import genai
from google.genai import types
from config import GEMINI_API_KEY

# Định nghĩa khung dữ liệu đầu ra cố định
class JobEvaluation(BaseModel):
    is_valid_job: bool = Field(description="True nếu đây là bài đăng tuyển dụng thực sự (không phải ứng viên tìm việc hay bán khóa học)")
    company_name: str = Field(description="Tên công ty/studio hoặc 'Ẩn danh'")
    role_title: str = Field(description="Tên vị trí tuyển dụng")
    seniority_level: str = Field(description="Cấp bậc: Intern / Fresher / Junior / Middle / Senior")
    tech_stack: list[str] = Field(description="Danh sách ngôn ngữ, framework, công cụ yêu cầu")
    salary_info: str = Field(description="Mức lương cụ thể hoặc 'Thỏa thuận'")
    work_location: str = Field(description="Địa điểm làm việc")
    contact_method: str = Field(description="Email hoặc cách thức ứng tuyển")
    transparency_score: int = Field(description="Điểm minh bạch từ 0 đến 35 (có tên cty +15, có lương rõ +10, có địa chỉ rõ +10)")
    credibility_score: int = Field(description="Điểm uy tín người đăng từ 0 đến 25 (Tech lead/HR có email tên miền cty +25, cò mồi/inbox kín +5)")
    profile_match_score: int = Field(description="Điểm khớp kỹ năng từ 0 đến 40 (Khớp Unity/C#/Game/C++/Java/Node.js và trình độ Intern/Fresher/Junior)")
    total_score: int = Field(description="Tổng 3 đầu điểm trên (0 - 100)")
    one_line_summary: str = Field(description="Tóm tắt ngắn gọn 1 câu lý do nên hay không nên nộp")

SYSTEM_PROMPT = """
Bạn là chuyên gia thẩm định tin tuyển dụng CNTT. Hãy phân tích bài viết và chấm điểm khắt khe trên thang 100 cho ứng viên có hồ sơ:
- Thế mạnh: Lập trình Game (Unity 2D/3D, C#, C++, SDL, Phaser) và Phát triển phần mềm/Backend (Java Spring Boot, Node.js, C#, SQL).
- Cấp bậc mục tiêu: Thực tập sinh (Intern), Mới ra trường (Fresher), hoặc Junior (dưới 2 năm kinh nghiệm).
- Khu vực ưu tiên: Hà Nội hoặc Remote.
Nếu bài yêu cầu Senior trên 3 năm kinh nghiệm hoặc lệch hẳn sang mảng không liên quan (Sales, Marketing, Kế toán), hãy trừ nặng điểm profile_match_score.
"""

def evaluate_job_with_ai(raw_text: str) -> dict | None:
    if not GEMINI_API_KEY or "DIEN_GEMINI" in GEMINI_API_KEY:
        print("[AI Scorer] Chưa cấu hình GEMINI_API_KEY!")
        return None

    client = genai.Client(api_key=GEMINI_API_KEY)
    try:
        response = client.models.generate_content(
            model="gemini-2.5-flash",
            contents=f"Phân tích bài đăng sau:\n\n{raw_text[:4000]}",
            config=types.GenerateContentConfig(
                system_instruction=SYSTEM_PROMPT,
                response_mime_type="application/json",
                response_schema=JobEvaluation,
                temperature=0.1,
            ),
        )
        return response.parsed.model_dump()
    except Exception as e:
        print(f"[AI Scorer] Lỗi khi gọi Gemini API: {e}")
        return None

```

