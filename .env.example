# ==========================================
# CẤU HÌNH JOBHUNTER BOT
# ==========================================

# 1. Google Gemini API Key (Lấy miễn phí tại https://aistudio.google.com/)
GEMINI_API_KEY=DIEN_GEMINI_API_KEY_CUA_BAN_VAO_DAY

# 2. Telegram Bot (Tạo bot qua @BotFather và lấy chat_id qua @userinfobot)
TELEGRAM_BOT_TOKEN=DIEN_TELEGRAM_TOKEN_VAO_DAY
TELEGRAM_CHAT_ID=DIEN_CHAT_ID_CUA_BAN_VAO_DAY

# 3. Google Sheets Webhook (Triển khai Google Apps Script và dán link vào đây, để trống nếu chưa dùng)
GOOGLE_SHEET_WEBHOOK=

# 4. Địa điểm quét LinkedIn
LINKEDIN_LOCATION=Hanoi, Vietnam

# 5. Ngưỡng điểm thông báo (0 - 100)
MIN_SCORE_NOTIFY=70
MIN_SCORE_BACKUP=50

# 6. Cổng Remote Debugging của Chrome
CHROME_DEBUG_PORT=9222
